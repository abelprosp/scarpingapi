generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SearchType {
  WEB
  IMAGES
  NEWS
  SHOPPING
  VIDEOS
  MAPS
  PLACES
  AUTOCOMPLETE
  RELATED_SEARCHES
  KNOWLEDGE_GRAPH
  REVERSE_IMAGE
}

enum ProxyType {
  RESIDENTIAL
  DATACENTER
  MOBILE
}

enum ProxyStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  API_KEY_CREATED
  API_KEY_REVOKED
  SEARCH_PERFORMED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELED
  CREDITS_PURCHASED
  SETTINGS_UPDATED
}

enum PixPaymentType {
  SUBSCRIPTION
  CREDIT_PACK
  OVERAGE
}

enum PixPaymentStatus {
  PENDING
  PAID
  EXPIRED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String?
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false) @map("email_verified")
  credits               Int       @default(2700)
  payAsYouGoEnabled     Boolean   @default(false) @map("pay_as_you_go_enabled")
  monthlyCreditsUsed    Int       @default(0) @map("monthly_credits_used")
  monthlyCreditsResetAt DateTime? @map("monthly_credits_reset_at")
  overageCreditsPending Int       @default(0) @map("overage_credits_pending")
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  apiKeys          ApiKey[]
  subscription     Subscription?
  usageLogs        UsageLog[]
  auditLogs        AuditLog[]
  invoices         Invoice[]
  pixPayments      PixPayment[]
  crawlJobs        CrawlJob[]
  researchSessions ResearchSession[]
  datasets         Dataset[]
  ragCollections   RagCollection[]

  @@map("users")
}

model ApiKey {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String
  keyHash     String       @unique @map("key_hash")
  keyPrefix   String       @map("key_prefix")
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?    @map("last_used_at")
  expiresAt   DateTime?    @map("expires_at")
  rateLimit   Int          @default(100) @map("rate_limit")
  permissions Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs UsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model Plan {
  id              String   @id @default(uuid())
  name            String
  tier            PlanTier @unique
  description     String?
  priceMonthly    Int      @map("price_monthly")
  priceYearly     Int      @map("price_yearly")
  creditsMonthly  Int      @map("credits_monthly")
  rateLimit       Int      @map("rate_limit")
  maxApiKeys      Int      @default(5) @map("max_api_keys")
  features        Json     @default("[]")
  stripePriceId   String?  @map("stripe_price_id")
  stripeProductId String?  @map("stripe_product_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  pixPayments   PixPayment[]

  @@map("plans")
}

model PixPayment {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  txid           String           @unique
  amount         Int
  creditsGranted Int              @map("credits_granted")
  type           PixPaymentType
  status         PixPaymentStatus @default(PENDING)
  qrCode         String?          @map("qr_code") @db.Text
  copyPaste      String?          @map("copy_paste") @db.Text
  planId         String?          @map("plan_id")
  quantity       Int              @default(1)
  expiresAt      DateTime?        @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  paidAt         DateTime?        @map("paid_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
  @@map("pix_payments")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model UsageLog {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  apiKeyId     String?    @map("api_key_id")
  searchType   SearchType @map("search_type")
  query        String
  country      String     @default("br")
  language     String     @default("pt")
  device       String     @default("desktop")
  creditsUsed  Int        @default(1) @map("credits_used")
  responseTime Int        @map("response_time")
  cached       Boolean    @default(false)
  success      Boolean    @default(true)
  errorMessage String?    @map("error_message")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([searchType, createdAt])
  @@index([apiKeyId])
  @@map("usage_logs")
}

model Invoice {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  stripeInvoiceId String?   @unique @map("stripe_invoice_id")
  amount          Int
  currency        String    @default("brl")
  status          String    @default("pending")
  paidAt          DateTime? @map("paid_at")
  invoiceUrl      String?   @map("invoice_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invoices")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountPct   Int       @map("discount_pct")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  validFrom     DateTime  @map("valid_from")
  validUntil    DateTime? @map("valid_until")
  isActive      Boolean   @default(true) @map("is_active")
  stripeCouponId String?  @map("stripe_coupon_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Proxy {
  id           String      @id @default(uuid())
  host         String
  port         Int
  username     String?
  password     String?
  type         ProxyType   @default(DATACENTER)
  status       ProxyStatus @default(ACTIVE)
  country      String?
  city         String?
  successCount Int         @default(0) @map("success_count")
  failureCount Int         @default(0) @map("failure_count")
  lastUsedAt   DateTime?   @map("last_used_at")
  lastCheckAt  DateTime?   @map("last_check_at")
  avgLatency   Int?        @map("avg_latency")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status, type])
  @@map("proxies")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  action    AuditAction
  resource  String?
  metadata  Json?
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

enum CrawlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ResearchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CrawlJob {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  seedUrl      String         @map("seed_url")
  status       CrawlJobStatus @default(PENDING)
  maxDepth     Int            @default(2) @map("max_depth")
  maxPages     Int            @default(50) @map("max_pages")
  pagesFound   Int            @default(0) @map("pages_found")
  results      Json?
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  completedAt  DateTime?      @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("crawl_jobs")
}

model ResearchSession {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  query       String
  status      ResearchStatus @default(PENDING)
  depth       Int            @default(1)
  report      Json?
  citations   Json?
  creditsUsed Int            @default(0) @map("credits_used")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("research_sessions")
}

model Dataset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  schema      Json     @default("{}")
  isPublic    Boolean  @default(false) @map("is_public")
  recordCount Int      @default(0) @map("record_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records DatasetRecord[]

  @@index([userId])
  @@index([isPublic])
  @@map("datasets")
}

model DatasetRecord {
  id        String   @id @default(uuid())
  datasetId String   @map("dataset_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("dataset_records")
}

model RagCollection {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  dimension Int      @default(384)
  docCount  Int      @default(0) @map("doc_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents RagDocument[]

  @@unique([userId, name])
  @@map("rag_collections")
}

model RagDocument {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  content      String
  metadata     Json?
  embedding    Json?
  chunkIndex   Int      @default(0) @map("chunk_index")
  createdAt    DateTime @default(now()) @map("created_at")

  collection RagCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("rag_documents")
}
