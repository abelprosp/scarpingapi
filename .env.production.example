# Copie para .env na VPS e ajuste os valores

POSTGRES_PASSWORD=serper_secret_change_me
JWT_SECRET=troque-por-um-secret-forte-de-64-chars
JWT_REFRESH_SECRET=troque-por-outro-secret-forte

# Porta da API exposta (8080 evita conflito com nginx/apache na VPS)
API_PORT=8080

# Só usado se subir com: docker compose --profile bundled-nginx up -d
HTTP_PORT=80

# Grafana (opcional, profile monitoring)
GRAFANA_PASSWORD=admin_change_me

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://serper:serper_secret_change_me@postgres:5432/serper?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

DEFAULT_COUNTRY=br
DEFAULT_LANGUAGE=pt
CACHE_ENABLED=true
PROXY_ENABLED=false
BROWSER_HEADLESS=true
