# Copie para .env na VPS e ajuste os valores

POSTGRES_PASSWORD=serper_secret_change_me
JWT_SECRET=troque-por-um-secret-forte-de-64-chars
JWT_REFRESH_SECRET=troque-por-outro-secret-forte

# Domínio de produção
API_DOMAIN=api.noviqsearch.online
API_PUBLIC_URL=https://api.noviqsearch.online
APP_URL=https://noviqsearch.online
APP_NAME=NoviqSearch
DEFAULT_FREE_CREDITS=2700
CORS_ORIGIN=https://noviqsearch.online,https://api.noviqsearch.online

# Frontend (docker compose web)
WEB_PORT=3001
NEXT_PUBLIC_API_URL=https://api.noviqsearch.online/api/v1

# Porta interna da API (nginx do host faz proxy para 127.0.0.1:8080)
API_PORT=8080

# Só usado se subir com: docker compose --profile bundled-nginx up -d
HTTP_PORT=80

# Grafana (opcional, profile monitoring)
GRAFANA_PASSWORD=admin_change_me

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://serper:serper_secret_change_me@postgres:5432/serper?schema=public
REDIS_HOST=redis
REDIS_PORT=6379

DEFAULT_COUNTRY=br
DEFAULT_LANGUAGE=pt
CACHE_ENABLED=true
PROXY_ENABLED=false
BROWSER_HEADLESS=true
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
