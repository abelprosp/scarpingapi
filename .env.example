# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Noviq Search API

# Domínio (produção)
# API_DOMAIN=api.noviqsearch.online
# API_PUBLIC_URL=https://api.noviqsearch.online
# APP_URL=https://api.noviqsearch.online
# CORS_ORIGIN=https://noviqsearch.online,https://api.noviqsearch.online

# Database
DATABASE_URL=postgresql://serper:serper_secret@localhost:5432/serper?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# API Keys
API_KEY_PREFIX=sk_

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Sentry
SENTRY_DSN=

# Search Engine
DEFAULT_SEARCH_ENGINE=google
DEFAULT_COUNTRY=br
DEFAULT_LANGUAGE=pt
DEFAULT_DEVICE=desktop

# Proxy
PROXY_ENABLED=false
PROXY_ROTATION_INTERVAL=10
PROXY_HEALTH_CHECK_INTERVAL=60000

# Browser
BROWSER_ENGINE=playwright
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=5
# Docker/Alpine: usa Chromium do sistema (evita npx playwright install)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Cache
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Credits
DEFAULT_FREE_CREDITS=2700
CREDITS_PER_SEARCH=2

# AI (optional - for result normalization)
AI_ENABLED=false
OPENAI_API_KEY=
